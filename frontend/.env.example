# PaperMark frontend configuration template.
# Copy to `.env.local` for development (git-ignored). Values here are placeholders.
# Every VITE_* value is PUBLIC: it is embedded in the JavaScript bundle.
# NEVER put the Supabase secret / service_role key here.

VITE_API_BASE_URL=http://localhost:8000/api/v1

# Supabase DEVELOPMENT project (used from Phase 1 for sign-in only)
VITE_SUPABASE_URL=https://YOUR_DEV_PROJECT_REF.supabase.co
# Publishable key (sb_publishable_...) from Project Settings > API Keys. Never a secret key.
VITE_SUPABASE_PUBLISHABLE_KEY=
