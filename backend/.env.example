# PaperMark backend configuration template.
# Copy to `.env` for local development. `.env` is git-ignored — never commit it.
# Every value below is a placeholder. Real secrets go in Render's environment settings.

ENVIRONMENT=development          # development | test | staging | production
LOG_LEVEL=INFO
EXPOSE_DOCS=false                # OpenAPI docs are always on in development/test

# Supabase Postgres — DEVELOPMENT project only. Never point at production data.
# Use the Supavisor *session* pooler string (port 5432) from
# Supabase dashboard > Connect > Session pooler.
DATABASE_URL=postgresql://postgres.YOUR_DEV_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
DATABASE_SSL=true

CORS_ORIGINS=http://localhost:5173

# Supabase API (needed from Phase 1)
SUPABASE_URL=https://YOUR_DEV_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=replace-with-dev-secret-key
SUPABASE_JWT_ISSUER=https://YOUR_DEV_PROJECT_REF.supabase.co/auth/v1
SUPABASE_JWKS_URL=https://YOUR_DEV_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json

# Background jobs: true on Render Free (runner inside the API process)
RUN_JOBS_IN_PROCESS=false

# AI provider: none | ollama | institution | hosted   (none = manual evaluation only)
AI_PROVIDER=none

# Only for running database tests locally against a DISPOSABLE database.
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/papermark_test
